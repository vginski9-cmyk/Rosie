{
  "name": "ARRT radiography clinical competency requirements",
  "authority": "ARRT (credential) · JRCERT (program accreditation)",
  "edition": "ARRT Radiography Didactic and Clinical Competency Requirements, 2022 edition (effective January 1, 2022) — starter content: verify against the current ARRT document before relying on counts",
  "kind": "competency",
  "sourceUrl": "https://www.arrt.org/pages/earn-arrt-credentials/initial-requirements/education-requirements/didactic-and-clinical-competency-requirements",
  "summary": "Every graduate must demonstrate competence, on patients, in the ARRT list: all 36 mandatory imaging procedures, 15 of the 34 electives (at least one from the Head section and at least two from the Fluoroscopy section, one of which must be an Upper GI series or a Contrast enema), and 10 general patient-care procedures. JRCERT does not set procedure counts; it requires the program to provide equitable clinical opportunities with documented supervision (direct until competency is achieved, indirect after; repeat exams under direct supervision) within each setting's approved clinical capacity — which is why every mandatory category below is mapped to the asset settings that can supply it and checked against the sites' assets.",
  "rules": [
    { "key": "mandatory", "label": "Mandatory imaging procedures", "min": 36, "of": 36, "scope": "category != Patient care && mandatory" },
    { "key": "elective", "label": "Elective imaging procedures", "min": 15, "of": 34, "scope": "!mandatory" },
    { "key": "elective-head", "label": "Electives from the Head section", "min": 1, "scope": "electiveGroup == head" },
    { "key": "elective-fluoro", "label": "Electives from the Fluoroscopy section", "min": 2, "scope": "electiveGroup == fluoro", "notes": "at least one must be an Upper GI series or a Contrast enema" },
    { "key": "patient-care", "label": "General patient-care procedures", "min": 10, "of": 10, "scope": "category == Patient care" },
    { "key": "simulation", "label": "Simulations", "notes": "ARRT permits a limited number of procedures to be simulated when patients are unavailable — see the current edition for the allowance per section" },
    { "key": "supervision", "label": "Supervision (JRCERT)", "notes": "direct supervision until competency is documented, indirect after; repeat radiographs always under direct supervision; a student is never a substitute for staff" }
  ],
