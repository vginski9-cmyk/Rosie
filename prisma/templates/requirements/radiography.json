{
  "name": "ARRT radiography clinical competency requirements",
  "authority": "ARRT (credential) · JRCERT (program accreditation)",
  "edition": "ARRT Radiography Didactic and Clinical Competency Requirements, effective March 1, 2027 (candidates completing after February 28, 2029 must use this list; earlier completers may use the 2022 list). Entered from ARRT's published change summary — confirm the elective count (16 vs 17), the section placement of the tube and line-placement procedures, and the simulation allowance against the PDF.",
  "kind": "competency",
  "sourceUrl": "https://www.arrt.org/pages/arrt-reference-documents/by-document-type/didactic-and-clinical-competency-requirements",
  "summary": "Every graduate must demonstrate competence, on patients, in the ARRT list: all 35 mandatory imaging procedures, 17 of the elective imaging procedures (at least one from the Head section and at least two from the Fluoroscopy section, one of which must be an Upper GI series or a Contrast enema), and all 8 general patient-care procedures. Up to 10 procedures may be simulated when patients are unavailable; no pediatric procedure may be simulated, and every procedure is performed with the candidate physically present at the facility. JRCERT does not set procedure counts; it requires equitable clinical opportunities with documented supervision — direct until competency is achieved, indirect after, and direct for every repeat — within each setting's approved clinical capacity. Every item is mapped to the asset settings that can supply it and checked against the sites' assets and their confirmed provision.",
  "rules": [
    {
      "key": "mandatory",
      "label": "Mandatory imaging procedures",
      "min": 35,
      "of": 35,
      "scope": "category != Patient care && mandatory"
    },
    {
      "key": "elective",
      "label": "Elective imaging procedures",
      "min": 17,
      "of": 38,
      "scope": "!mandatory",
      "notes": "ARRT's 2027 summary: required electives rose from 15 — confirm 16 or 17 in the PDF"
    },
    {
      "key": "elective-head",
      "label": "Electives from the Head section",
      "min": 1,
      "scope": "electiveGroup == head"
    },
    {
      "key": "elective-fluoro",
      "label": "Electives from the Fluoroscopy section",
      "min": 2,
      "scope": "electiveGroup == fluoro",
      "anyOf": [
        "Upper GI series",
        "Contrast enema"
      ],
      "notes": "at least one must be an Upper GI series or a Contrast enema"
    },
    {
      "key": "patient-care",
      "label": "General patient-care procedures",
      "min": 8,
      "of": 8,
      "scope": "category == Patient care"
    },
    {
      "key": "simulation",
      "label": "Simulations",
      "max": 10,
      "scope": "simulated",
      "notes": "up to 10 procedures may be simulated; pediatric procedures may not be"
    },
    {
      "key": "supervision",
      "label": "Supervision (JRCERT)",
      "notes": "direct supervision until competency is documented, indirect after; repeat radiographs always under direct supervision; a student is never a substitute for staff"
    }
  ],
  "definitions": {
    "trauma": "modifications in positioning, tube angle or detector placement due to injury, with monitoring of the patient's condition",
    "pediatric": "age 6 years or younger — all pediatric procedures are elective and may not be simulated",
    "geriatric": "at least 65 years old and physically and/or cognitively impaired due to aging"
  },
