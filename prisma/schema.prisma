// Rosie data model.
// Dev uses SQLite (file-based, boots instantly). The schema is written to be
// Postgres-portable: no native enums, no Json/array columns, explicit tenant
// scoping via institutionId on every root entity. Swap `provider = "postgresql"`
// and the DATABASE_URL to deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TENANCY
// ---------------------------------------------------------------------------

/// The tenant root. Everything hangs off an Institution so we can aggregate /
/// disaggregate across institutions in a multi-tenant deployment later.
model Institution {
  id           String   @id @default(cuid())
  name         String
  shortName    String?
  serviceArea  String? // free-text description of the geographic service area
  /// Academic calendar pattern: each semester starts on the Monday on/after this
  /// MM-DD anchor. Derived term dates (lock-in) follow it, year after year.
  springStart  String  @default("01-08")
  summerStart  String  @default("05-28")
  fallStart    String  @default("08-15")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  academicEvents AcademicEvent[]
  programs       Program[]
  programFamilies ProgramFamily[]
  regions        Region[]
  occupations    Occupation[]
  demand         DemandProjection[]
  calendarBlocks CalendarBlock[]
  people         Person[]
  employers      Employer[]
  skills         Skill[]
  proficiencyScales ProficiencyScale[]
  wblProfiles    WblProfile[]
  wblSnapshots   WblSnapshot[]
  assignments    Assignment[]
  facilities     Facility[]
}

/// A physical teaching space: classroom, lab, clinical/sim facility. Captures the
/// supply side — size/capacity, hours, availability, and equipment — so delivery
/// (sections, labs, clinicals) can be mapped onto real rooms.
model Facility {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  /// CLASSROOM | LAB | CLINICAL | SIM | OTHER
  kind          String  @default("CLASSROOM")
  building      String?
  capacity      Int?    // seats / stations
  areaSqft      Int?    // floor area
  hours         String? // operating hours, e.g. "Mon–Fri 8a–9p"
  availability  String? // availability notes / open days
  equipment     String? // equipment list (freeform / comma-separated)
  notes         String?
  status        String  @default("active") // active | inactive
  createdAt     DateTime @default(now())

  sectionSchedules SectionSchedule[]
  meetings MeetingPattern[]
  shiftMoves ShiftMove[]

  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// LABOR-MARKET DEMAND  (Lightcast SOC-code analysis)
// ---------------------------------------------------------------------------

/// An occupation, keyed by SOC code (e.g. 29-2034 Radiologic Technologists).
model Occupation {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  socCode       String
  title         String
  createdAt     DateTime @default(now())

  demand   DemandProjection[]
  programs Program[]
  families ProgramFamily[]

  @@unique([institutionId, socCode])
  @@index([institutionId])
}

/// A PROGRAM FAMILY groups multiple program TEMPLATES that lead to the same
/// occupation/credential (e.g. "Radiography" → Traditional, Accelerated, Evening
/// variants). The family is where multi-year workforce goals are anchored and
/// where the constellation of cohorts across all its templates is monitored.
model ProgramFamily {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  occupationId  String?
  occupation    Occupation? @relation(fields: [occupationId], references: [id])
  name          String
  description   String?
  /// Serialized North-Star goal plan (anchor, rates, term retention, demand) —
  /// edited in the family hub's goal planner. JSON blob for portability.
  goalPlan      String?
  createdAt     DateTime @default(now())

  programs Program[]
  interventions Intervention[]

  @@index([institutionId])
}

/// A geography the demand is measured against. `kind` is one of:
/// NATIONAL | STATE | MSA | RADIUS_60 | RADIUS_45 | SERVICE_AREA.
model Region {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  kind          String
  sortOrder     Int      @default(0)

  demand DemandProjection[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

/// One demand observation: occupation x region x year.
/// jobs = stock of jobs; openings = growth + replacement openings that year.
model DemandProjection {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  occupationId  String
  occupation    Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  year          Int
  jobs          Float?
  openings      Float?
  growthPct     Float?
  replacementPct Float?
  turnoverPct   Float?

  @@unique([occupationId, regionId, year])
  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// PROGRAM STRUCTURE  (the "one student's experience" archetype)
// ---------------------------------------------------------------------------

/// A program type: any variation in entry point, sequencing, or instructional
/// model (Traditional ADN, LPN-to-RN bridge, Accelerated BSN, ...).
model Program {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  occupationId  String?
  occupation    Occupation? @relation(fields: [occupationId], references: [id])
  familyId      String?
  family        ProgramFamily? @relation(fields: [familyId], references: [id])
  name          String
  programType   String // e.g. "Traditional Full Time"
  credential    String? // e.g. "Diploma", "AAS", "Certificate"
  serviceArea   String?
  status        String   @default("active") // active | draft | archived
  monthsToFullProductivity Int? // lag from completion to "fully productive"
  // --- Launch cadence & delivery calendar ---
  /// Calendar slots this program delivers in, in order (CSV of FALL|SPRING|SUMMER).
  /// Programs that skip summer use "FALL,SPRING"; trimester programs use all three.
  termSlots     String   @default("FALL,SPRING,SUMMER")
  /// ANNUAL | BIENNIAL | MULTI_PER_YEAR | ON_DEMAND
  launchCadence String   @default("ANNUAL")
  /// Term codes a new cohort launches in (CSV). One for annual, several for multi-per-year.
  launchTerms   String   @default("FALL")
  /// Years between launch cycles (2 = biennial). Ignored for ON_DEMAND.
  launchIntervalYears Int @default(1)
  /// Fallback planned seats per cohort when a year has no explicit target.
  defaultCohortSeats Float?
  // --- Workload assumption cells (clinical capacity model AH–AN) ---
  /// "Full time faculty student contact hours" — cell AI2.
  facContactHours   Float @default(16)
  /// "Number of hours in work week" (faculty) — cell AJ2.
  facWorkWeekHours  Float @default(40)
  /// "Number of weeks in Term" (faculty) — cell AL2.
  facTermWeeks      Float @default(18)
  /// "Full time preceptor contact hours" — cell AI5.
  preContactHours   Float @default(40)
  /// "Number of hours in work week" (preceptor) — cell AJ5.
  preWorkWeekHours  Float @default(40)
  /// "Number of weeks in Term" (preceptor) — cell AL5.
  preTermWeeks      Float @default(18)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  terms        Term[]
  cohorts      Cohort[]
  yearTargets  ProgramYearTarget[]
  programSkills ProgramSkill[]
  assignments  Assignment[]
  students     Student[]

  @@index([institutionId])
}

/// Annual North-Star targets for a program: how many credentials to produce and
/// the cohort capacity required to get there.
model ProgramYearTarget {
  id              String  @id @default(cuid())
  programId       String
  program         Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  year            Int
  credentialTarget Float?  // target completers/credentials for the year
  cohortCapacity   Float?  // seats needed to hit the target given funnel rates

  @@unique([programId, year])
  @@index([programId])
}

/// An archetypal term in the program sequence (Term 1..N). startWeek/endWeek
/// define the instructional window used to validate session timing.
model Term {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  index     Int // 1-based position in the sequence
  name      String
  startWeek Int?
  endWeek   Int?
  /// Real-world first day of the term — anchors the day-by-day calendar.
  startDate DateTime?

  courses Course[]
  assignments Assignment[]
  cohortTerms CohortTerm[]
  placements WblPlacement[]

  @@unique([programId, index])
  @@index([programId])
}

/// A course within a term. Weekly hours capture the instructional load a single
/// student must complete for each component; totals are derived by the engine.
model Course {
  id                 String @id @default(cuid())
  termId             String
  term               Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  code               String?
  name               String
  sequenceOrder      Int    @default(0) // position within the term (drag-to-reorder)
  weeklyClassHours   Float  @default(0) // catalog "Class Hours" (weekly contact)
  weeklyLabHours     Float  @default(0) // catalog "Lab Hours"
  weeklyClinicalHours Float @default(0) // catalog "Clinical Hours"
  // --- Catalog metadata (for the curriculum flow + course detail) ---
  creditHours        Float?
  semesterOffered    String? // Fall | Spring | Summer | All
  description        String?
  requisites         String? // prerequisite / corequisite narrative
  courseType         String? // CORE | GENED | SUPPORT — for flow-chart coloring

  sessions Session[]
  cohortDates CohortCourseDates[]
  courseSkills CourseSkill[]
  grades   StudentCourseGrade[]
  meetings MeetingPattern[]

  @@index([termId])
}

/// One required instructional session in a single student's experience.
/// kind = CLASS | LAB | CLINICAL. The engine scales these by enrollment to
/// compute how many real sections/slots/instructors are needed.
model Session {
  id            String @id @default(cuid())
  courseId      String
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind          String
  number        Int
  title         String?
  lengthHours   Float  @default(0)
  deliveryMode  String? // in-person | online | hybrid
  location      String? // lecture hall | skills lab | clinical site ...
  maxStudents   Int    @default(1) // capacity of ONE instance of this session
  /// Faculty per instance — Float because clinical oversight is often fractional
  /// (e.g. 1/21 of a clinical instructor per 1-student preceptor session).
  facultyNeeded Float  @default(1)
  supportStaffNeeded Float @default(0)
  preceptorsNeeded   Float @default(0) // clinical only
  week          Int?
  dayOfWeek     String? // Mon | Tue | Wed | Thu | Fri | Sat | Sun
  startTime     String? // time of day, "HH:MM" (24h)
  rotationType  String? // clinical: Med-Surg, OR, Imaging, ...
  clinicalMode  String? // clinical: instructor-led | preceptor-led | hybrid
  notes         String?
  homework      String? // assignment / homework / prep tied to this session
  /// "Contact hour policy for faculty during session (___hrs per contact hour)" — workbook column N.
  facultyContactPolicy   Float?
  /// "Contact hour policy for support staff during session (___hrs per contact hour)" — workbook column P.
  supportContactPolicy   Float?
  /// "Contact hour policy for preceptors during session (___hrs per contact hour)" — workbook column U.
  preceptorContactPolicy Float?

  skillLinks SessionSkill[]
  instructors SessionInstructor[]
  sectionSchedules SectionSchedule[]
  resources SessionResource[]
  overrides SessionOverride[]
  shiftMoves ShiftMove[]

  @@index([courseId])
}

/// A learning resource attached to a session: homework / outside assignment /
/// reading / video / practice / material — what students read, watch, or practice
/// for this session. Richer than the legacy Session.homework string.
model SessionResource {
  id         String @id @default(cuid())
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// HOMEWORK | ASSIGNMENT | READING | VIDEO | PRACTICE | MATERIAL
  kind       String  @default("READING")
  title      String
  url        String?
  detail     String?
  estMinutes Int?
  sortOrder  Int     @default(0)
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

/// Per-OFFERING scheduling override for ONE section of a session. The template
/// gives a session a default day/time/place; an offering may need to stagger its
/// N sections (six labs can't all run at once) across different slots/rooms. Each
/// row overrides one section's weekly slot for a specific cohort run.
model SectionSchedule {
  id           String  @id @default(cuid())
  cohortId     String
  cohort       Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  sessionId    String
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionIndex Int
  dayOfWeek    String?
  startTime    String? // "HH:MM"
  location     String?
  /// The assigned room (a Facility). `location` mirrors its name so the calendar
  /// and clash engine (which key on the room string) keep working unchanged.
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@unique([cohortId, sessionId, sectionIndex])
  @@index([cohortId])
  @@index([sessionId])
}

/// Who staffs a session, and for how many of its contact hours. Co-teaching is
/// modeled by multiple rows whose contactHours sum to (at most) the session
/// length — e.g. a 3-hr class split 2 hrs / 1 hr between two instructors.
model SessionInstructor {
  id           String  @id @default(cuid())
  sessionId    String
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId     String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// The OFFERING (cohort run) this staffing belongs to. Null = a template-level
  /// default applying to any offering that hasn't assigned its own staff.
  cohortId     String?
  cohort       Cohort? @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  role         String  @default("instructor") // instructor | preceptor | support
  contactHours Float   // portion of the session length this person covers
  segment      String? // what they cover, e.g. "Lecture" | "Lab supervision"

  @@index([sessionId])
  @@index([personId])
  @@index([cohortId])
}

// ---------------------------------------------------------------------------
// CALENDAR / DATE DIMENSION  (drives real scheduling from the archetype)
// ---------------------------------------------------------------------------

/// A schedulable block within an academic term (16/14/12/8/5-week, etc.).
/// nonHoliday* = count of teachable weekdays after holidays are removed; these
/// convert "weekly hours" into real per-term session counts.
/// One coded line of the institution's academic calendar — imported from the
/// college's web page / PDF / spreadsheet. Semester starts drive the term-date
/// engine for the years they cover; holidays & breaks flag every session that
/// lands on them.
model AcademicEvent {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  date          DateTime
  endDate       DateTime?
  label         String
  kind          String   // term_start | term_end | session_start | holiday | other
  season        String?  // Spring | Summer | Fall
  source        String?  // the pasted line it was read from
  createdAt     DateTime @default(now())

  @@index([institutionId, date])
}

model CalendarBlock {
  id            String  @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  blockKey      String
  termKey       String?
  academicYear  Int?
  termCode      String? // SPRING | SUMMER | FALL
  name          String
  startDate     DateTime?
  endDate       DateTime?
  lengthWeeks   Int?
  lengthDays    Int?
  nonHolidayMon Int?
  nonHolidayTue Int?
  nonHolidayWed Int?
  nonHolidayThu Int?
  nonHolidayFri Int?

  @@unique([institutionId, blockKey])
  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// TALENT-PIPELINE FUNNEL
// ---------------------------------------------------------------------------

/// A cohort moving through the funnel (e.g. "Class of 2029").
///
/// A Cohort is also the program's INSTANTIATION / OFFERING: a specific scheduled
/// run of the timeless Program template. The template defines terms/courses/
/// sessions in the abstract; the offering binds them to real calendar dates
/// (via CohortTerm), assigns real instructors (SessionInstructor.cohortId), and
/// enrolls real students.
model Cohort {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  entryYear Int?
  /// Entry term code (FALL|SPRING|SUMMER) — used for on-demand / explicit cohorts.
  entryTermCode String?
  /// Planned Term-1 seats for this specific cohort (overrides program defaults).
  plannedSeats  Float?
  /// When true this cohort is an explicit launch included in the plan as-is.
  isExplicit    Boolean @default(false)
  /// --- Offering / instantiation fields ---
  /// Real-world first day of this offering's first term (anchors the calendar).
  startDate     DateTime?
  /// planned | active | completed | archived
  status        String  @default("planned")
  /// Cohort-specific talent-pipeline plan: { goal, rates, termOverrides } JSON —
  /// set from the goal page's per-offering panel; overrides the family defaults.
  pipelineRates String?

  stages      FunnelStage[]
  students    Student[]
  cohortTerms CohortTerm[]
  sessionOverrides SessionOverride[]
  shiftMoves ShiftMove[]
  courseDates CohortCourseDates[]
  sessionStaff SessionInstructor[]
  sectionSchedules SectionSchedule[]
  placements  WblPlacement[]
  meetings    MeetingPattern[]

  @@index([programId])
}

/// Per-offering scheduling of a template term: the real-world start date this
/// cohort begins a given Term. Lets one template be run on different calendars.
model CohortTerm {
  id        String  @id @default(cuid())
  cohortId  String
  cohort    Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  startDate DateTime?

  @@unique([cohortId, termId])
  @@index([cohortId])
}

/// Per-INSTANTIATION course window: courses inside one term run different
/// lengths (8-, 12-, 14-, 16-week), so each offering can date every course —
/// the start anchors that course's session weeks; the end marks its last day.
model CohortCourseDates {
  id        String  @id @default(cuid())
  cohortId  String
  cohort    Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate DateTime?
  endDate   DateTime?

  @@unique([cohortId, courseId])
  @@index([cohortId])
}

/// A per-INSTANTIATION override of one template session: the boilerplate stays
/// timeless, while a specific offering can move a session's week, day, time,
/// or annotate it — without touching any other offering.
model SessionOverride {
  id        String  @id @default(cuid())
  cohortId  String
  cohort    Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Every input column of the session table can be overridden per offering —
  // null = inherit the template's value. Same shape as Session's inputs.
  week      Int?
  dayOfWeek String?
  startTime String?
  notes     String?
  title        String?
  deliveryMode String?
  location     String?
  lengthHours  Float?
  maxStudents  Int?
  facultyNeeded          Float?
  facultyContactPolicy   Float?
  supportStaffNeeded     Float?
  supportContactPolicy   Float?
  preceptorsNeeded       Float?
  preceptorContactPolicy Float?
  rotationType String?
  clinicalMode String?

  @@unique([cohortId, sessionId])
  @@index([cohortId])
}

/// One stage of the talent-pipeline funnel for a cohort, with target vs actual.
/// stageKey is one of the canonical stages (see lib/funnel.ts STAGES).
model FunnelStage {
  id           String @id @default(cuid())
  cohortId     String
  cohort       Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  stageKey     String
  sortOrder    Int
  label        String
  targetNumber Float?
  actualNumber Float?

  @@unique([cohortId, stageKey])
  @@index([cohortId])
}

// ---------------------------------------------------------------------------
// STAKEHOLDERS
// ---------------------------------------------------------------------------

/// People who staff or support delivery: instructors, support staff,
/// preceptors, clinical supervisors, program coordinators.
model Person {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  role          String // instructor | support | preceptor | supervisor | coordinator
  title         String? // job title, e.g. "Clinical Coordinator", "Lead MRI Tech"
  email         String?
  /// Whether the person is currently affiliated with the org (employed/contracted).
  /// Distinct from "currently working" — which is derived from active assignments
  /// in the term in session today.
  active        Boolean @default(true)
  /// Affiliation window. endDate set = departed/inactive.
  startDate     DateTime?
  endDate       DateTime?
  employmentType String? // full-time | part-time | adjunct | contract | preceptor
  employerId    String?
  employer      Employer? @relation(fields: [employerId], references: [id])
  assignments   Assignment[]
  sessionStaff  SessionInstructor[]
  meetings      MeetingPattern[]
  shiftMoves    ShiftMove[]

  @@index([institutionId])
}

/// A bookable, recurring weekly meeting — the single source of truth that ties a
/// cohort's course section to a day/time, a room (Facility), and a staff member.
/// One row per (cohort, course, kind, section). The offering term-grid/calendar/
/// staffing views AND the institution-wide master space calendar all read these,
/// so a move in one surface shows up everywhere. Clinical meetings live off-campus
/// (facilityId null / a CLINICAL facility) and don't compete for classroom space.
/// A FUNCTIONAL UNIT inside a clinical site — the asset map's master grain.
/// Capacity math happens here: beds/rooms/stations × shifts × days →
/// students per shift, preceptors per shift, weekly student slots.
model ClinicalUnit {
  id            String   @id @default(cuid())
  employerId    String
  employer      Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  externalId    String?  // asset-map unit_id (C001…)
  unitType      String   // Med-Surg / Telemetry · ICU / CCU · Operating Room Suite · SNF Nursing Unit …
  unitCategory  String   // Inpatient beds · Surgical · Emergency · Imaging · Laboratory · Long-term care beds · Adult care beds · Behavioral health
  unitName      String?
  capacityCount Float?
  uom           String?  // beds | rooms | bays | scanners | stations
  /// VERIFIED (licensure/SMFP) | ESTIMATE (derived from licensed beds) | GAP (unknown)
  dataSource    String   @default("ESTIMATE")
  shiftsPerDay  Int      @default(2)
  shiftLengthHrs Float   @default(12)
  /// Comma list of shift blocks the unit runs: Day,Evening,Night
  shiftBlocks   String   @default("Day,Night")
  /// Comma list of weekdays the unit can host students: Mon,Tue,…
  days          String   @default("Mon,Tue,Wed,Thu,Fri,Sat,Sun")
  studentsPerShift Int   @default(0)
  studentsPerPreceptor Int @default(1)
  preceptorsPerShift Int @default(0)
  natcepEligible Boolean?
  status        String   @default("active") // active | inactive
  notes         String?
  createdAt     DateTime @default(now())

  meetings   MeetingPattern[]
  shiftMoves ShiftMove[]

  @@index([employerId])
  @@index([unitCategory])
}

/// How a program's clinical ROTATION TYPE maps to the asset map's unit
/// categories — the join between clinical demand and physical supply.
model RotationSetting {
  id            String @id @default(cuid())
  institutionId String
  rotationType  String
  unitCategory  String
  unitType      String?
  /// patients per student for this rotation (tightens the students-per-shift ceiling)
  patientsPerStudent Float?
  notes         String?

  @@unique([institutionId, rotationType])
}

/// ONE occurrence of a booked section moved off its weekly pattern: the shift
/// that would have landed on `fromDate` happens on `toDate` instead (optionally
/// at a different time / place / with different staff). The weekly booking is
/// untouched — space is fluid one day at a time.
/// One shift occurrence (a session × section of a cohort, on the date its weekly
/// pattern puts it) moved to another date / time / place. Keyed by the SESSION so
/// exactly one chip moves — never every session that shares a weekly booking.
model ShiftMove {
  id            String   @id @default(cuid())
  cohortId      String
  cohort        Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionIndex  Int      @default(1)
  meetingId     String?
  meeting       MeetingPattern? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  fromDate      DateTime
  toDate        DateTime
  startTime     String?
  facilityId    String?
  facility      Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  employerId    String?
  employer      Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)
  unitId        String?
  unit          ClinicalUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  staffPersonId String?
  staff         Person?   @relation(fields: [staffPersonId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([cohortId, sessionId, sectionIndex, fromDate])
  @@index([cohortId])
}

model MeetingPattern {
  id           String  @id @default(cuid())
  cohortId     String
  cohort       Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind         String  // CLASS | LAB | CLINICAL
  sectionIndex Int     @default(1) // 1-based section number
  sectionCount Int     @default(1) // total sections for this (course, kind) in this cohort
  seats        Int     @default(0) // students assigned to THIS section
  dayOfWeek    String  // Mon | Tue | Wed | Thu | Fri | Sat | Sun
  startTime    String  // HH:MM (24h)
  lengthHours  Float   @default(1)
  termIndex    Int     @default(1)
  startWeek    Int     @default(1) // first instructional week it recurs
  endWeek      Int     @default(16) // last instructional week
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  /// CLINICAL meetings are hosted at a partner site rather than a campus room —
  /// this puts the rotation on the same master calendar, attributed to the partner.
  employerId   String?
  employer     Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)
  /// The functional unit (bed unit / OR suite / …) inside the site that hosts this section.
  unitId       String?
  unit         ClinicalUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  staffPersonId String?
  staff         Person?  @relation(fields: [staffPersonId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  moves        ShiftMove[]

  @@index([cohortId])
  @@index([courseId])
  @@index([facilityId])
  @@index([staffPersonId])
  @@index([employerId])
}

/// An employer / clinical partner that hires graduates and/or hosts WBL.
model Employer {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  setting       String? // acute-care hospital | imaging center | ambulatory surgical center ...
  wblSlots      Int?    // clinical/WBL slots the partner can host
  notes         String?
  /// Partnership lifecycle: prospect | active | paused | archived
  status        String  @default("active")
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  city          String?
  /// ── Clinical asset map (facility level) ──
  externalId    String?  // asset-map facility_id (H001…)
  organization  String?  // licensee / health system
  facilityType  String?  // Acute care hospital | Ambulatory surgery center | Nursing home | …
  county        String?
  ring          String?  // Core | Ring 1 | Ring 2
  licensedBeds  Int?
  nursingHomeBeds Int?
  adultCareBeds Int?
  operatingRooms Int?
  annualSurgicalCases Int?
  /// Agreement lifecycle with THIS institution: none | prospect | asked | secured | declined
  agreementStatus String @default("none")
  agreementNotes  String?
  sourceNote    String?

  units ClinicalUnit[]
  people Person[]
  wblSnapshots WblSnapshot[]
  placements WblPlacement[]
  alignmentProfiles AlignmentProfile[]
  meetings MeetingPattern[]
  shiftMoves ShiftMove[]

  @@index([institutionId])
}

/// A work-based-learning placement: a student hosted by an employer for a rotation
/// (optionally tied to a cohort + term window). The operational record behind
/// "assign WBL" — distinct from the WblSnapshot (a point-in-time fit/readiness capture).
model WblPlacement {
  id           String @id @default(cuid())
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employerId   String
  employer     Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  cohortId     String?
  cohort       Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  termId       String?
  term         Term? @relation(fields: [termId], references: [id], onDelete: SetNull)
  startDate    DateTime?
  endDate      DateTime?
  hoursPerWeek Float?
  modality     String?  // CT | MRI | general | mammography ...
  /// planned | active | completed | cancelled
  status       String  @default("planned")
  notes        String?
  createdAt    DateTime @default(now())

  @@index([studentId])
  @@index([employerId])
  @@index([cohortId])
}

// ---------------------------------------------------------------------------
// KSA / PROFICIENCY FRAMEWORK
//
// A shared institution-wide proficiency scale (numbered levels with generic
// meaning) gives every skill a comparable benchmark axis; each skill then layers
// its own per-level descriptors on top. Programs and courses reference skills and
// set the target proficiency level a graduate / course should reach.
// ---------------------------------------------------------------------------

/// An institution's proficiency scale (e.g. 5 levels: Awareness → Expert).
model ProficiencyScale {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  isDefault     Boolean @default(false)

  levels ProficiencyLevel[]

  @@index([institutionId])
}

/// One level on a proficiency scale. `level` is the comparable numeric rank.
model ProficiencyLevel {
  id      String @id @default(cuid())
  scaleId String
  scale   ProficiencyScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  level   Int
  label   String // "Awareness", "Foundational", "Proficient", "Advanced", "Expert"
  summary String? // generic meaning of this level, scale-wide

  @@unique([scaleId, level])
}

/// A Knowledge, Skill, or Ability in the institution's library. Reusable across
/// programs and courses, short-term and long-term alike.
model Skill {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  type          String  @default("SKILL") // KNOWLEDGE | SKILL | ABILITY
  category      String? // grouping, e.g. "Technical", "Professional", "Clinical"
  definition    String?
  howUsed       String? // context-of-use narrative (role-specific)
  source        String  @default("manual") // manual | lightcast | import
  externalId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  descriptors   SkillLevelDescriptor[]
  programSkills ProgramSkill[]
  courseSkills  CourseSkill[]
  sessionSkills SessionSkill[]
  assessments   StudentSkillAssessment[]

  @@index([institutionId])
}

/// Per-skill narrative descriptor for a given proficiency level (maps to the
/// institution scale's numeric level). E.g. Agile Methodology @ Level 1/2/3.
model SkillLevelDescriptor {
  id         String @id @default(cuid())
  skillId    String
  skill      Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      Int
  descriptor String

  @@unique([skillId, level])
}

/// Graduate proficiency benchmark: the level a program expects its graduates to
/// reach in a skill.
model ProgramSkill {
  id          String @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  targetLevel Int
  priority    String? // core | supporting
  notes       String?

  @@unique([programId, skillId])
  @@index([skillId])
}

/// Course-level curriculum mapping: the level a course develops a skill to, and
/// whether it introduces / reinforces / masters it.
model CourseSkill {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  targetLevel Int
  role        String? // INTRODUCED | REINFORCED | MASTERED

  @@unique([courseId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// WBL ALIGNMENT ENGINE
//
// The three-layer model (motivations / constraints / capacities) profiled on
// both sides — learner and employer. Alignment between a learner profile and an
// employer profile is computed live by the engine from these factors.
// ---------------------------------------------------------------------------

/// A profile of one side of a work-based-learning relationship.
model WblProfile {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subjectType   String // LEARNER | EMPLOYER
  name          String
  /// Soft references (no FK) to a cohort or employer this profile represents.
  cohortId      String?
  employerId    String?
  tier          String? // employer tier or learner segment
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  factors WblFactor[]

  @@index([institutionId])
}

/// One factor in a WBL profile, on one of the three layers.
model WblFactor {
  id         String @id @default(cuid())
  profileId  String
  profile    WblProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  layer      String // MOTIVATION | CONSTRAINT | CAPACITY
  label      String
  detail     String?
  /// Strength / importance of this factor (0–1+).
  weight     Float   @default(1)
  /// True if this is a hard requirement that must be met (a "binding" constraint).
  binding    Boolean @default(false)
  /// How the factor surfaced: STATED | INFERRED | HIDDEN | UNKNOWN.
  disclosure String  @default("STATED")
  /// Free-text key used to match a learner factor to an employer factor.
  matchKey   String?

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// WBL DATED SNAPSHOTS  (point-in-time capture, per individual student + employer)
//
// Where WblProfile is a cohort-level archetype, a WblSnapshot is a dated capture
// of ONE student's (or employer's) work-based-learning picture at a moment in
// time. Re-capturing over a term produces a history; the alignment engine reads
// each student's latest snapshot to recommend placements and surface unmet needs.
// ---------------------------------------------------------------------------

model WblSnapshot {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// LEARNER_STUDENT | EMPLOYER
  subjectType   String
  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employerId    String?
  employer      Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  asOfDate      DateTime
  summary       String?
  /// Optional structured snapshot fields (learner side) for richer recommendations.
  maxTravelMinutes Int?
  transport        String? // own-car | public-transit | rides | none
  availability     String? // CSV of available day codes, e.g. "Mon,Tue,Wed,Thu,Fri"
  shiftPreference  String? // day | evening | flexible
  targetWage       Float?
  desiredModality  String? // CT | MRI | general | mammography ...
  createdAt        DateTime @default(now())

  factors WblSnapshotFactor[]

  @@index([institutionId])
  @@index([studentId])
  @@index([employerId])
}

model WblSnapshotFactor {
  id         String @id @default(cuid())
  snapshotId String
  snapshot   WblSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  layer      String  // MOTIVATION | CONSTRAINT | CAPACITY
  label      String
  detail     String?
  weight     Float   @default(1)
  binding    Boolean @default(false)
  disclosure String  @default("STATED")
  matchKey   String?

  @@index([snapshotId])
}

// ---------------------------------------------------------------------------
// CONNECTIVE TISSUE — where supply meets demand, and skills meet delivery
// ---------------------------------------------------------------------------

/// Staff SUPPLY: a person committed to a program (optionally a specific term) at
/// some FTE. Reconciled against the faculty/preceptor FTE DEMAND the capacity
/// engine computes, to surface staffing gaps.
model Assignment {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  personId      String
  person        Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  programId     String
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  termId        String?
  term          Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)
  role          String  // instructor | preceptor | support | coordinator
  fteCommitment Float   @default(1) // how much instructional FTE this person supplies
  notes         String?

  @@index([programId])
  @@index([personId])
}

/// Skills at the DELIVERY/ASSESSMENT grain: which session develops and/or
/// assesses a skill. Because sessions scale with enrollment in the capacity
/// engine, this is how skill-delivery and competency-assessment volume scale too
/// — closing the loop from curriculum design → delivery → assessment → funnel.
model SessionSkill {
  id          String @id @default(cuid())
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  mode        String  @default("DELIVER") // DELIVER | ASSESS | BOTH
  targetLevel Int?    // level this session develops/assesses the skill to

  @@unique([sessionId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// STUDENT / SIS LAYER
//
// Real named students moving through a program. Each student carries a funnel
// stage (so the pipeline can be drilled into by name), dated course grades,
// dated KSA proficiency assessments, and dated attendance/absence records.
// This is the read-side that makes every funnel number and roster clickable
// down to individual people.
// ---------------------------------------------------------------------------

/// One enrolled (or prospective) student in a program cohort.
model Student {
  id            String  @id @default(cuid())
  programId     String
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohortId      String?
  cohort        Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  name          String
  email         String?
  /// Lifecycle status: prospect | applicant | admitted | enrolled | completed | licensed | placed | withdrawn
  status        String  @default("enrolled")
  /// Current funnel stage key (matches FunnelStage.stageKey) — drives drill-down.
  stageKey      String?
  entryYear     Int?
  gpa           Float?
  attendedCount Int     @default(0)
  missedCount   Int     @default(0)
  /// Cohort section/group this student belongs to (1-based). Maps the student to
  /// specific lab/clinical section shifts on the calendar.
  sectionIndex  Int     @default(1)
  /// Clinical rotation site/group, when on clinical rotations.
  clinicalSite  String?
  createdAt     DateTime @default(now())

  grades      StudentCourseGrade[]
  assessments StudentSkillAssessment[]
  absences    StudentAbsence[]
  wblSnapshots WblSnapshot[]
  placements  WblPlacement[]
  alignmentProfiles AlignmentProfile[]

  @@index([programId])
  @@index([cohortId])
}

/// A student's outcome in one course (dated, with letter grade / points).
model StudentCourseGrade {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termIndex     Int
  status        String   @default("in_progress") // in_progress | completed | withdrawn | failed
  grade         String?  // letter grade
  gradePoints   Float?   // 0–4 scale
  completedDate DateTime?

  @@index([studentId])
  @@index([courseId])
}

/// A dated assessment of a student's proficiency in one KSA/skill.
model StudentSkillAssessment {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level        Int      // proficiency level reached (maps to the institution scale)
  assessedDate DateTime
  courseCode   String?  // where the assessment happened
  method       String?  // checkoff | exam | clinical eval | simulation ...

  @@index([studentId])
  @@index([skillId])
}

/// A dated attendance record for a single session a student missed (or made up).
model StudentAbsence {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  courseCode   String?
  sessionTitle String?
  excused      Boolean  @default(false)

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// ALIGNMENT ENGINE — structured WBL intake on learners AND employers.
//
// The Alignment Engine framework: three layers per side (motivation, constraint,
// capacity), captured at checkpoints across the placement lifecycle (P0 intake →
// P+24), tagged against a curated taxonomy with tier weights (driving → absent)
// and binding flags. Everything downstream — quadrant position, recommended WBL
// modes, configuration guidance, MVD intake requirement, cohort-level design —
// is COMPUTED from these tags by src/lib/alignment.ts.
// ---------------------------------------------------------------------------

/// One captured profile for a learner or employer at a checkpoint. A subject can
/// have several (P0 intake, mid-placement, exit, +6mo, +24mo) — blend evolution
/// is read by comparing checkpoints.
model AlignmentProfile {
  id          String  @id @default(cuid())
  subjectType String  // LEARNER | EMPLOYER
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  employerId  String?
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  /// Checkpoint in the placement lifecycle: P0 (intake) | PMID | P1 (exit) | P6 | P24
  checkpoint  String  @default("P0")
  /// MVD tier this intake was conducted at: 1 | 2 | 3
  mvdTier     Int     @default(2)
  /// The narrative capture — "tell me how you came to be considering this."
  narrative   String?
  /// Who conducted the intake (free text; staff name).
  conductedBy String?
  capturedAt  DateTime @default(now())

  tags AlignmentTag[]

  @@index([studentId])
  @@index([employerId])
}

/// One tagged taxonomy leaf on a profile. Layer decides which fields matter:
/// MOTIVATION → tier (1 driving · 2 shaping · 3 active · 4 latent) + optional
/// conditionalOn (the leaf code this motivation depends on — the F.10 cascade);
/// CONSTRAINT → binding (true = strikes placements, a design parameter);
/// CAPACITY → note (what the person brings; recognition text).
model AlignmentTag {
  id           String @id @default(cuid())
  profileId    String
  profile      AlignmentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  layer        String // MOTIVATION | CONSTRAINT | CAPACITY
  code         String // taxonomy leaf code, e.g. "B.2.b", "H.6.a", "EC3.a", "EP2.b"
  tier         Int?   // motivations only: 1..4
  binding      Boolean @default(false) // constraints only
  conditionalOn String? // motivations only: leaf code this is conditional on
  note         String?

  @@index([profileId])
  @@index([code])
}

/// A top-of-funnel / pipeline intervention for a program family — instantiated
/// from the template library or authored fresh. Lives on the partner-lane ×
/// funnel-stage matrix and is sequenced (order + window) within its lane.
model Intervention {
  id          String @id @default(cuid())
  familyId    String
  family      ProgramFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// Partner lane: MIDDLE_SCHOOL | HIGH_SCHOOL | COMMUNITY_COLLEGE | EMPLOYER | CROSS_CUTTING
  lane        String
  /// Pipeline stage: AWARENESS | READINESS | APPLICATION | WBL | SUPPORTS | RETENTION
  stage       String
  title       String
  description String?
  /// Priority population(s): comma-separated, e.g. "K-12", "Adult learners",
  /// "Declared pre-Rad", "Single parents", "First-generation"
  populations String?
  owner       String? // named owner (person/org), per the TPS workgroup model
  /// proposed | planned | active | complete | paused
  status      String  @default("proposed")
  sequence    Int     @default(0) // order within its lane
  startDate   DateTime?
  endDate     DateTime?
  estCostLow  Int?    // annual $ band
  estCostHigh Int?
  /// Funnel stage key this intervention is trying to move (interested | qualified |
  /// offered | enrolled | completing | licensed | placed | productive)
  targetStageKey String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([familyId])
}
