// Rosie data model.
// Dev uses SQLite (file-based, boots instantly). The schema is written to be
// Postgres-portable: no native enums, no Json/array columns, explicit tenant
// scoping via institutionId on every root entity. Swap `provider = "postgresql"`
// and the DATABASE_URL to deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TENANCY
// ---------------------------------------------------------------------------

/// The tenant root. Everything hangs off an Institution so we can aggregate /
/// disaggregate across institutions in a multi-tenant deployment later.
model Institution {
  id           String   @id @default(cuid())
  name         String
  shortName    String?
  serviceArea  String? // free-text description of the geographic service area
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  programs       Program[]
  regions        Region[]
  occupations    Occupation[]
  demand         DemandProjection[]
  calendarBlocks CalendarBlock[]
  people         Person[]
  employers      Employer[]
  skills         Skill[]
  proficiencyScales ProficiencyScale[]
  wblProfiles    WblProfile[]
  assignments    Assignment[]
}

// ---------------------------------------------------------------------------
// LABOR-MARKET DEMAND  (Lightcast SOC-code analysis)
// ---------------------------------------------------------------------------

/// An occupation, keyed by SOC code (e.g. 29-2034 Radiologic Technologists).
model Occupation {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  socCode       String
  title         String
  createdAt     DateTime @default(now())

  demand   DemandProjection[]
  programs Program[]

  @@unique([institutionId, socCode])
  @@index([institutionId])
}

/// A geography the demand is measured against. `kind` is one of:
/// NATIONAL | STATE | MSA | RADIUS_60 | RADIUS_45 | SERVICE_AREA.
model Region {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  kind          String
  sortOrder     Int      @default(0)

  demand DemandProjection[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

/// One demand observation: occupation x region x year.
/// jobs = stock of jobs; openings = growth + replacement openings that year.
model DemandProjection {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  occupationId  String
  occupation    Occupation @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  regionId      String
  region        Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  year          Int
  jobs          Float?
  openings      Float?
  growthPct     Float?
  replacementPct Float?
  turnoverPct   Float?

  @@unique([occupationId, regionId, year])
  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// PROGRAM STRUCTURE  (the "one student's experience" archetype)
// ---------------------------------------------------------------------------

/// A program type: any variation in entry point, sequencing, or instructional
/// model (Traditional ADN, LPN-to-RN bridge, Accelerated BSN, ...).
model Program {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  occupationId  String?
  occupation    Occupation? @relation(fields: [occupationId], references: [id])
  name          String
  programType   String // e.g. "Traditional Full Time"
  credential    String? // e.g. "Diploma", "AAS", "Certificate"
  serviceArea   String?
  status        String   @default("active") // active | draft | archived
  monthsToFullProductivity Int? // lag from completion to "fully productive"
  // --- Launch cadence & delivery calendar ---
  /// Calendar slots this program delivers in, in order (CSV of FALL|SPRING|SUMMER).
  /// Programs that skip summer use "FALL,SPRING"; trimester programs use all three.
  termSlots     String   @default("FALL,SPRING,SUMMER")
  /// ANNUAL | BIENNIAL | MULTI_PER_YEAR | ON_DEMAND
  launchCadence String   @default("ANNUAL")
  /// Term codes a new cohort launches in (CSV). One for annual, several for multi-per-year.
  launchTerms   String   @default("FALL")
  /// Years between launch cycles (2 = biennial). Ignored for ON_DEMAND.
  launchIntervalYears Int @default(1)
  /// Fallback planned seats per cohort when a year has no explicit target.
  defaultCohortSeats Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  terms        Term[]
  cohorts      Cohort[]
  yearTargets  ProgramYearTarget[]
  programSkills ProgramSkill[]
  assignments  Assignment[]
  students     Student[]

  @@index([institutionId])
}

/// Annual North-Star targets for a program: how many credentials to produce and
/// the cohort capacity required to get there.
model ProgramYearTarget {
  id              String  @id @default(cuid())
  programId       String
  program         Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  year            Int
  credentialTarget Float?  // target completers/credentials for the year
  cohortCapacity   Float?  // seats needed to hit the target given funnel rates

  @@unique([programId, year])
  @@index([programId])
}

/// An archetypal term in the program sequence (Term 1..N). startWeek/endWeek
/// define the instructional window used to validate session timing.
model Term {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  index     Int // 1-based position in the sequence
  name      String
  startWeek Int?
  endWeek   Int?
  /// Real-world first day of the term — anchors the day-by-day calendar.
  startDate DateTime?

  courses Course[]
  assignments Assignment[]

  @@unique([programId, index])
  @@index([programId])
}

/// A course within a term. Weekly hours capture the instructional load a single
/// student must complete for each component; totals are derived by the engine.
model Course {
  id                 String @id @default(cuid())
  termId             String
  term               Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  code               String?
  name               String
  sequenceOrder      Int    @default(0) // position within the term (drag-to-reorder)
  weeklyClassHours   Float  @default(0) // catalog "Class Hours" (weekly contact)
  weeklyLabHours     Float  @default(0) // catalog "Lab Hours"
  weeklyClinicalHours Float @default(0) // catalog "Clinical Hours"
  // --- Catalog metadata (for the curriculum flow + course detail) ---
  creditHours        Float?
  semesterOffered    String? // Fall | Spring | Summer | All
  description        String?
  requisites         String? // prerequisite / corequisite narrative
  courseType         String? // CORE | GENED | SUPPORT — for flow-chart coloring

  sessions Session[]
  courseSkills CourseSkill[]
  grades   StudentCourseGrade[]

  @@index([termId])
}

/// One required instructional session in a single student's experience.
/// kind = CLASS | LAB | CLINICAL. The engine scales these by enrollment to
/// compute how many real sections/slots/instructors are needed.
model Session {
  id            String @id @default(cuid())
  courseId      String
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind          String
  number        Int
  title         String?
  lengthHours   Float  @default(0)
  deliveryMode  String? // in-person | online | hybrid
  location      String? // lecture hall | skills lab | clinical site ...
  maxStudents   Int    @default(1) // capacity of ONE instance of this session
  facultyNeeded Int    @default(1) // faculty per instance
  supportStaffNeeded Int @default(0)
  preceptorsNeeded   Int @default(0) // clinical only
  week          Int?
  dayOfWeek     String? // Mon | Tue | Wed | Thu | Fri | Sat | Sun
  startTime     String? // time of day, "HH:MM" (24h)
  rotationType  String? // clinical: Med-Surg, OR, Imaging, ...
  clinicalMode  String? // clinical: instructor-led | preceptor-led | hybrid
  notes         String?

  skillLinks SessionSkill[]

  @@index([courseId])
}

// ---------------------------------------------------------------------------
// CALENDAR / DATE DIMENSION  (drives real scheduling from the archetype)
// ---------------------------------------------------------------------------

/// A schedulable block within an academic term (16/14/12/8/5-week, etc.).
/// nonHoliday* = count of teachable weekdays after holidays are removed; these
/// convert "weekly hours" into real per-term session counts.
model CalendarBlock {
  id            String  @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  blockKey      String
  termKey       String?
  academicYear  Int?
  termCode      String? // SPRING | SUMMER | FALL
  name          String
  startDate     DateTime?
  endDate       DateTime?
  lengthWeeks   Int?
  lengthDays    Int?
  nonHolidayMon Int?
  nonHolidayTue Int?
  nonHolidayWed Int?
  nonHolidayThu Int?
  nonHolidayFri Int?

  @@unique([institutionId, blockKey])
  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// TALENT-PIPELINE FUNNEL
// ---------------------------------------------------------------------------

/// A cohort moving through the funnel (e.g. "Class of 2029").
model Cohort {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  entryYear Int?
  /// Entry term code (FALL|SPRING|SUMMER) — used for on-demand / explicit cohorts.
  entryTermCode String?
  /// Planned Term-1 seats for this specific cohort (overrides program defaults).
  plannedSeats  Float?
  /// When true this cohort is an explicit launch included in the plan as-is.
  isExplicit    Boolean @default(false)

  stages   FunnelStage[]
  students Student[]

  @@index([programId])
}

/// One stage of the talent-pipeline funnel for a cohort, with target vs actual.
/// stageKey is one of the canonical stages (see lib/funnel.ts STAGES).
model FunnelStage {
  id           String @id @default(cuid())
  cohortId     String
  cohort       Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  stageKey     String
  sortOrder    Int
  label        String
  targetNumber Float?
  actualNumber Float?

  @@unique([cohortId, stageKey])
  @@index([cohortId])
}

// ---------------------------------------------------------------------------
// STAKEHOLDERS
// ---------------------------------------------------------------------------

/// People who staff or support delivery: instructors, support staff,
/// preceptors, clinical supervisors, program coordinators.
model Person {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  role          String // instructor | support | preceptor | supervisor | coordinator
  email         String?
  employerId    String?
  employer      Employer? @relation(fields: [employerId], references: [id])
  assignments   Assignment[]

  @@index([institutionId])
}

/// An employer / clinical partner that hires graduates and/or hosts WBL.
model Employer {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  setting       String? // acute-care hospital | imaging center | ambulatory surgical center ...
  wblSlots      Int?    // clinical/WBL slots the partner can host
  notes         String?

  people Person[]

  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// KSA / PROFICIENCY FRAMEWORK
//
// A shared institution-wide proficiency scale (numbered levels with generic
// meaning) gives every skill a comparable benchmark axis; each skill then layers
// its own per-level descriptors on top. Programs and courses reference skills and
// set the target proficiency level a graduate / course should reach.
// ---------------------------------------------------------------------------

/// An institution's proficiency scale (e.g. 5 levels: Awareness → Expert).
model ProficiencyScale {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  isDefault     Boolean @default(false)

  levels ProficiencyLevel[]

  @@index([institutionId])
}

/// One level on a proficiency scale. `level` is the comparable numeric rank.
model ProficiencyLevel {
  id      String @id @default(cuid())
  scaleId String
  scale   ProficiencyScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  level   Int
  label   String // "Awareness", "Foundational", "Proficient", "Advanced", "Expert"
  summary String? // generic meaning of this level, scale-wide

  @@unique([scaleId, level])
}

/// A Knowledge, Skill, or Ability in the institution's library. Reusable across
/// programs and courses, short-term and long-term alike.
model Skill {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  type          String  @default("SKILL") // KNOWLEDGE | SKILL | ABILITY
  category      String? // grouping, e.g. "Technical", "Professional", "Clinical"
  definition    String?
  howUsed       String? // context-of-use narrative (role-specific)
  source        String  @default("manual") // manual | lightcast | import
  externalId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  descriptors   SkillLevelDescriptor[]
  programSkills ProgramSkill[]
  courseSkills  CourseSkill[]
  sessionSkills SessionSkill[]
  assessments   StudentSkillAssessment[]

  @@index([institutionId])
}

/// Per-skill narrative descriptor for a given proficiency level (maps to the
/// institution scale's numeric level). E.g. Agile Methodology @ Level 1/2/3.
model SkillLevelDescriptor {
  id         String @id @default(cuid())
  skillId    String
  skill      Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      Int
  descriptor String

  @@unique([skillId, level])
}

/// Graduate proficiency benchmark: the level a program expects its graduates to
/// reach in a skill.
model ProgramSkill {
  id          String @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  targetLevel Int
  priority    String? // core | supporting
  notes       String?

  @@unique([programId, skillId])
  @@index([skillId])
}

/// Course-level curriculum mapping: the level a course develops a skill to, and
/// whether it introduces / reinforces / masters it.
model CourseSkill {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  targetLevel Int
  role        String? // INTRODUCED | REINFORCED | MASTERED

  @@unique([courseId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// WBL ALIGNMENT ENGINE
//
// The three-layer model (motivations / constraints / capacities) profiled on
// both sides — learner and employer. Alignment between a learner profile and an
// employer profile is computed live by the engine from these factors.
// ---------------------------------------------------------------------------

/// A profile of one side of a work-based-learning relationship.
model WblProfile {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subjectType   String // LEARNER | EMPLOYER
  name          String
  /// Soft references (no FK) to a cohort or employer this profile represents.
  cohortId      String?
  employerId    String?
  tier          String? // employer tier or learner segment
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  factors WblFactor[]

  @@index([institutionId])
}

/// One factor in a WBL profile, on one of the three layers.
model WblFactor {
  id         String @id @default(cuid())
  profileId  String
  profile    WblProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  layer      String // MOTIVATION | CONSTRAINT | CAPACITY
  label      String
  detail     String?
  /// Strength / importance of this factor (0–1+).
  weight     Float   @default(1)
  /// True if this is a hard requirement that must be met (a "binding" constraint).
  binding    Boolean @default(false)
  /// How the factor surfaced: STATED | INFERRED | HIDDEN | UNKNOWN.
  disclosure String  @default("STATED")
  /// Free-text key used to match a learner factor to an employer factor.
  matchKey   String?

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// CONNECTIVE TISSUE — where supply meets demand, and skills meet delivery
// ---------------------------------------------------------------------------

/// Staff SUPPLY: a person committed to a program (optionally a specific term) at
/// some FTE. Reconciled against the faculty/preceptor FTE DEMAND the capacity
/// engine computes, to surface staffing gaps.
model Assignment {
  id            String @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  personId      String
  person        Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  programId     String
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  termId        String?
  term          Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)
  role          String  // instructor | preceptor | support | coordinator
  fteCommitment Float   @default(1) // how much instructional FTE this person supplies
  notes         String?

  @@index([programId])
  @@index([personId])
}

/// Skills at the DELIVERY/ASSESSMENT grain: which session develops and/or
/// assesses a skill. Because sessions scale with enrollment in the capacity
/// engine, this is how skill-delivery and competency-assessment volume scale too
/// — closing the loop from curriculum design → delivery → assessment → funnel.
model SessionSkill {
  id          String @id @default(cuid())
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  mode        String  @default("DELIVER") // DELIVER | ASSESS | BOTH
  targetLevel Int?    // level this session develops/assesses the skill to

  @@unique([sessionId, skillId])
  @@index([skillId])
}

// ---------------------------------------------------------------------------
// STUDENT / SIS LAYER
//
// Real named students moving through a program. Each student carries a funnel
// stage (so the pipeline can be drilled into by name), dated course grades,
// dated KSA proficiency assessments, and dated attendance/absence records.
// This is the read-side that makes every funnel number and roster clickable
// down to individual people.
// ---------------------------------------------------------------------------

/// One enrolled (or prospective) student in a program cohort.
model Student {
  id            String  @id @default(cuid())
  programId     String
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohortId      String?
  cohort        Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  name          String
  email         String?
  /// Lifecycle status: prospect | applicant | admitted | enrolled | completed | licensed | placed | withdrawn
  status        String  @default("enrolled")
  /// Current funnel stage key (matches FunnelStage.stageKey) — drives drill-down.
  stageKey      String?
  entryYear     Int?
  gpa           Float?
  attendedCount Int     @default(0)
  missedCount   Int     @default(0)
  createdAt     DateTime @default(now())

  grades      StudentCourseGrade[]
  assessments StudentSkillAssessment[]
  absences    StudentAbsence[]

  @@index([programId])
  @@index([cohortId])
}

/// A student's outcome in one course (dated, with letter grade / points).
model StudentCourseGrade {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termIndex     Int
  status        String   @default("in_progress") // in_progress | completed | withdrawn | failed
  grade         String?  // letter grade
  gradePoints   Float?   // 0–4 scale
  completedDate DateTime?

  @@index([studentId])
  @@index([courseId])
}

/// A dated assessment of a student's proficiency in one KSA/skill.
model StudentSkillAssessment {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level        Int      // proficiency level reached (maps to the institution scale)
  assessedDate DateTime
  courseCode   String?  // where the assessment happened
  method       String?  // checkoff | exam | clinical eval | simulation ...

  @@index([studentId])
  @@index([skillId])
}

/// A dated attendance record for a single session a student missed (or made up).
model StudentAbsence {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  courseCode   String?
  sessionTitle String?
  excused      Boolean  @default(false)

  @@index([studentId])
}
