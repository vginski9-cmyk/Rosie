# Local dev (SQLite) — created automatically by `npm run setup`.
DATABASE_URL="file:./dev.db"

# Hosted (Vercel + Postgres): set DATABASE_URL to your Postgres connection
# string. The easiest path is Vercel's Neon integration, which sets this for
# you automatically (see docs/DEPLOY.md). Example shape:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
